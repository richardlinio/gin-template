// Database Schema for Go Gin Backend Template
// Generated: 2026-01-16
// Description: Minimal authentication system with JWT token management

// ============================================================
// Authentication Module
// ============================================================

Enum user_role {
  STUDENT [note: 'Student role']
  TEACHER [note: 'Teacher role']
  ADMIN [note: 'Administrator role']
}

Table users {
  id bigserial [primary key]
  username varchar(50) [not null, unique, note: 'Username: alphanumeric with length constraints']
  password_hash varchar(72) [not null, note: 'Bcrypt password hash']
  role user_role [not null, default: 'STUDENT', note: 'User role']
  experience_points integer [not null, default: 0, note: 'Experience points, starts at 0']
  level integer [not null, default: 1, note: 'User level, starts at 1']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [null, note: 'Soft delete timestamp']

  indexes {
    username [unique]
    experience_points [name: 'idx_users_experience', note: 'For leaderboard queries']
  }

  note: 'User accounts table'
}

Table access_tokens {
  id bigserial [primary key]
  token_jti varchar(64) [not null, unique, note: 'JWT Token ID (jti claim) - unique identifier']
  user_id bigint [not null, ref: > users.id, note: 'Associated user ID']
  expires_at timestamp [not null, note: 'Token expiration time']
  invalidated_at timestamp [not null, default: `now()`, note: 'Token invalidation time (logout timestamp)']
  created_at timestamp [not null, default: `now()`]

  indexes {
    token_jti [unique, name: 'idx_invalid_tokens_jti']
    user_id [name: 'idx_invalid_tokens_user_id']
    expires_at [name: 'idx_invalid_tokens_expires', note: 'For cleanup of expired tokens']
  }

  note: 'JWT Token blacklist table - stores logged out or revoked tokens'
}

Table refresh_tokens {
  id bigserial [primary key]
  token_jti varchar(64) [not null, unique, note: 'JWT Token ID (jti claim) - unique identifier']
  user_id bigint [not null, ref: > users.id, note: 'Associated user ID']
  expires_at timestamp [not null, note: 'Token expiration time']
  revoked_at timestamp [null, note: 'Token revocation time - NULL = valid, non-NULL = revoked']
  created_at timestamp [not null, default: `now()`]

  indexes {
    token_jti [unique, name: 'idx_refresh_tokens_jti']
    user_id [name: 'idx_refresh_tokens_user_id']
    expires_at [name: 'idx_refresh_tokens_expires', note: 'For cleanup of expired tokens']
  }

  note: 'Refresh tokens table - implements dual token pattern for secure token rotation'
}

// ============================================================
// Relationships
// ============================================================
// - One user can have multiple invalidated access tokens (one-to-many)
// - One user can have multiple refresh tokens (one-to-many)
// - Access tokens are added to blacklist table on logout to prevent reuse
// - Refresh tokens use revoked_at to mark revoked tokens (soft delete)
// - Expired tokens should be periodically cleaned up via scheduled job
