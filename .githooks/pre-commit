#!/usr/bin/env bash
# pre-commit: format staged Go / SQL files, then re-stage them.
#
# Design philosophy (mirrors lint-staged + Biome --staged --write):
#   1. Pick the staged files that match the formatters we run.
#   2. Run the formatters on the working-tree copies of those files.
#   3. `git add` the formatted results so they land in this commit.
#
# We deliberately do NOT try to isolate staged from unstaged hunks. If a file
# has both staged and unstaged changes, the formatter rewrites the whole file
# (staged + unstaged), and the unstaged portion stays in the working tree —
# the next commit will pick it up. gofumpt and pg_format are idempotent and
# touch only syntax, so this is safe in practice and matches how the wider
# JS / Python ecosystem handles partial-stage formatting.
#
# Trade-off: if you have unstaged changes in a staged file, those unstaged
# lines also get formatted (but stay unstaged). This is intentional — the
# previous "absolute isolation" design broke whenever fmt touched a context
# line that an unstaged hunk depended on, forcing a stash/retry/pop dance.

set -euo pipefail

# ───────── friendly precheck: backend container running? ─────────
if ! command -v docker >/dev/null 2>&1; then
  echo "pre-commit: 'docker' CLI not found — required by formatters." >&2
  exit 1
fi

if [ -z "$(docker compose ps --status running -q backend 2>/dev/null || true)" ]; then
  echo "pre-commit: 'backend' service is not running." >&2
  echo "            Start it with: make up" >&2
  echo "            (then re-run your commit)" >&2
  exit 1
fi

# ───────── collect staged Go / SQL files ─────────
# `--diff-filter=d` excludes deletions (can't `git add` them).
# Use NUL separators to survive paths with spaces.
go_files=()
sql_files=()
while IFS= read -r -d '' p; do
  case "$p" in
    *.go)  go_files+=("$p") ;;
    *.sql) sql_files+=("$p") ;;
  esac
done < <(git diff -z --name-only --cached --diff-filter=d)

# Nothing to format → exit clean.
if [ ${#go_files[@]} -eq 0 ] && [ ${#sql_files[@]} -eq 0 ]; then
  exit 0
fi

# ───────── format staged files in place ─────────
# gofumpt is idempotent and only touches whitespace/imports — running it on a
# file with mixed staged+unstaged content is safe.
if [ ${#go_files[@]} -gt 0 ]; then
  docker compose exec -T backend gofumpt -w "${go_files[@]}"
fi

# pg_format is more aggressive (rewrites SQL formatting), but in this repo
# SQL files rarely have concurrent staged+unstaged edits.
if [ ${#sql_files[@]} -gt 0 ]; then
  docker compose exec -T backend pg_format \
    --config /app/.pg_format \
    --inplace \
    --multiline \
    --placeholder "-- \+goose StatementBegin[\s\S]*?-- \+goose StatementEnd\n*" \
    "${sql_files[@]}"
fi

# ───────── re-stage the formatted versions ─────────
# Skip files fmt didn't touch — re-adding them is a no-op but adds noise.
for p in "${go_files[@]}" "${sql_files[@]}"; do
  if ! git diff --quiet -- "$p"; then
    git add -- "$p"
  fi
done
